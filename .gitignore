# Rust build output - any Cargo target dir at any depth (Cargo.lock IS committed).
# Must be **/target, not rust/target: the wasm binding crate is workspace-excluded
# and builds its own rust/bindings/wasm/target/.
**/target/

# browser demo (Vite): deps + build output
demo/node_modules/
demo/dist/

# C#/.NET proof build output (regenerated by `dotnet run`)
rust/bindings/uniffi/csharp_proof/bin/
rust/bindings/uniffi/csharp_proof/obj/

# built native lib copied next to a generated binding to run its proof
rust/bindings/**/*.dylib

# generated transfer artifacts (send/receive output) + OS noise
*.mp4
*.png
*.ppm
.DS_Store

docs/

# editors
.idea/
.claude/
CLAUDE.local.md

# conformance vector PNGs are real committed artifacts, not noise
!rust/tests/vectors/qr/*.png
# social / SEO preview card for the browser demo
!demo/public/og-card.png
.vercel
